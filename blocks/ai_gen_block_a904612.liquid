{% doc %}
  @prompt
    Create a premium "Contactez-nous" section for a luxury lighting brand.
    
    Title: CONTACTEZ-NOUS
    Subtitle: Nous sommes à votre écoute pour toute question ou demande.
    
    Layout:
    Display 3 contact cards in one row on desktop and stacked on mobile.
    
    Each card must contain:
    • a circular icon at the top
    • a title
    • contact information
    • soft shadow and rounded corners
    
    Cards:
    
    Card 1
    Icon: **Official WhatsApp icon (brand logo)**
    Title: WhatsApp
    Text: 0662266366
    Button: Nous écrire sur WhatsApp
    
    Card 2
    Icon: **Phone icon**
    Title: Téléphone
    Text: Appelez-nous directement
    Number: 0606431434
    Button: Appeler maintenant
    
    Card 3
    Icon: **Instagram icon (official logo)**
    Title: Instagram
    Text: @yallahshop1
    Button: Voir Instagram
    
    Design style:
    • minimalist and luxury
    • white cards
    • rounded corners (14px)
    • soft shadow
    • icon inside a circular beige background
    • gold accent color (#C8A97E)
    • clean modern typography
    
    Icons must use **real brand icons for WhatsApp and Instagram**, not generic chat icons.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-contact-section-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: 60px 20px;
    background-color: {{ block.settings.background_color }};
    display: block;
  }

  .ai-contact-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 50px;
  }

  .ai-contact-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 15px 0;
    font-weight: 700;
    letter-spacing: 2px;
  }

  .ai-contact-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.subtitle_color }};
    margin: 0;
    font-weight: 400;
  }

  .ai-contact-cards-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-contact-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: 40px 30px;
    text-align: center;
    box-shadow: 0 4px 20px rgba(0, 0, 0, {{ block.settings.shadow_opacity }});
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .ai-contact-card-{{ ai_gen_id }}:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 30px rgba(0, 0, 0, {{ block.settings.shadow_opacity | times: 1.5 }});
  }

  .ai-contact-icon-wrapper-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    border-radius: 50%;
    background-color: {{ block.settings.icon_background }};
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 25px;
  }

  .ai-contact-icon-wrapper-{{ ai_gen_id }} svg {
    width: calc({{ block.settings.icon_size }}px * 0.5);
    height: calc({{ block.settings.icon_size }}px * 0.5);
  }

  .ai-contact-card-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_title_size }}px;
    color: {{ block.settings.card_title_color }};
    margin: 0 0 15px 0;
    font-weight: 600;
  }

  .ai-contact-card-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_text_size }}px;
    color: {{ block.settings.card_text_color }};
    margin: 0 0 10px 0;
    line-height: 1.6;
  }

  .ai-contact-card-number-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_number_size }}px;
    color: {{ block.settings.accent_color }};
    margin: 0 0 25px 0;
    font-weight: 600;
  }

  .ai-contact-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 14px 28px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_text_size }}px;
    font-weight: 500;
    transition: all 0.3s ease;
    border: 2px solid {{ block.settings.button_background }};
  }

  .ai-contact-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_background }};
  }

  @media screen and (max-width: 989px) {
    .ai-contact-cards-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 25px;
    }

    .ai-contact-section-{{ ai_gen_id }} {
      padding: 40px 20px;
    }

    .ai-contact-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.8);
    }

    .ai-contact-subtitle-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.subtitle_size }}px * 0.9);
    }
  }
{% endstyle %}

<contact-section-{{ ai_gen_id }} class="ai-contact-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-contact-header-{{ ai_gen_id }}">
    {% if block.settings.title != blank %}
      <h2 class="ai-contact-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
    {% endif %}
    {% if block.settings.subtitle != blank %}
      <p class="ai-contact-subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</p>
    {% endif %}
  </div>

  <div class="ai-contact-cards-{{ ai_gen_id }}">
    <div class="ai-contact-card-{{ ai_gen_id }}">
